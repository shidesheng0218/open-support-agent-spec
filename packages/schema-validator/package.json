{
  "name": "@osas/schema-validator",
  "version": "0.2.1",
  "description": "Ajv 2020-12 based JSON Schema validation for OSAS objects against the schemas/ manifest.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shidesheng0218/open-support-agent-spec.git",
    "directory": "packages/schema-validator"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@osas/core": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
