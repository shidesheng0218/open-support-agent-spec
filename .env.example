# OSAS reference API — environment template (Milestone 2).
# Copy to .env for local development. NEVER commit real secrets.

# --- Runtime ---------------------------------------------------------------
# PORT=3001
# SEED_DEMO=true
# LOG_LEVEL=info

# --- Authentication (Milestone 2) ------------------------------------------
# demo (default): header-driven principals (x-osas-role / x-osas-actor-id /
# x-tenant-id). NOT allowed when NODE_ENV=production — startup fails closed.
OSAS_AUTH_MODE=demo
# jwt: verify OIDC Bearer tokens against a JWKS endpoint. Tenant and roles
# come from verified claims (sub / tenant_id / roles); x-tenant-id is ignored.
# OSAS_AUTH_MODE=jwt
# OSAS_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# OSAS_JWT_ISSUER=https://your-idp.example.com/
# OSAS_JWT_AUDIENCE=osas-api

# --- Storage (Milestone 2) ---------------------------------------------------
# memory (default): in-memory stores, no external service needed.
# postgres: requires DATABASE_URL; startup fails closed if unreachable.
# Run `pnpm db:migrate` (and `pnpm db:seed`) first.
OSAS_STORAGE=memory
# DATABASE_URL=postgres://osas:osas@localhost:5432/osas

# --- LLM provider & cost control (Milestone 2) -------------------------------
# mock (default): deterministic, network-free.
# openai-compatible: any OpenAI-style /chat/completions endpoint.
OSAS_LLM_PROVIDER=mock
# OSAS_LLM_BASE_URL=https://api.example.com/v1
# OSAS_LLM_API_KEY=          # read from env only; never logged or audited
# OSAS_LLM_MODEL_FAST=gpt-4o-mini          # classify / extract
# OSAS_LLM_MODEL_STANDARD=gpt-4o           # reply / propose
# Prices (USD per million tokens). Set BOTH or NEITHER — without them costs
# are recorded as unknown, never fabricated.
# OSAS_LLM_INPUT_USD_PER_MTOKEN=0.15
# OSAS_LLM_OUTPUT_USD_PER_MTOKEN=0.60
# Budgets: 80% writes a budget_warning audit event; at the cap, model calls
# are blocked before reaching the provider.
# OSAS_LLM_DAILY_BUDGET_USD=10
# OSAS_LLM_CASE_BUDGET_USD=0.50

# --- Execution mode (Milestone 3) ------------------------------------------
# shadow (default): proposals are simulated; ShadowRuns record what would
# have been auto-executed; humans write the final outcome.
# live: NOT available in v0.1.1 — startup refuses with
# LIVE_EXECUTION_NOT_AVAILABLE_IN_V0_1_1 (requires a future RFC).
OSAS_EXECUTION_MODE=shadow

# --- Zendesk reference adapter (optional; fail closed when unset) -----------
# ZENDESK_BASE_URL=https://acme.zendesk.com   # or ZENDESK_SUBDOMAIN=acme
# ZENDESK_EMAIL=agent@acme.example
# ZENDESK_API_TOKEN=          # env only; never logged or audited
# ZENDESK_ESCALATION_GROUP_ID=4242            # default human-escalation group

# --- Shopify reference adapter (optional, READ-ONLY) ------------------------
# No refund write path exists in v0.1.1; read scopes suffice.
# SHOPIFY_SHOP_DOMAIN=acme.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN= # env only; never logged or audited
# SHOPIFY_API_VERSION=2025-01
