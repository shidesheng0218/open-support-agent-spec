  "dependencies": {
    "@osas/adapter": "workspace:*",
    "@osas/core": "workspace:*",
    "@osas/mcp-server": "workspace:*",
    "@osas/mock-backend": "workspace:*",
    "@osas/policy-engine": "workspace:*",
    "@osas/schema-validator": "workspace:*"
  }
}
