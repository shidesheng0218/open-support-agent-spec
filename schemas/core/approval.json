{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-support-agent.dev/schemas/core/approval.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "specVersion",
    "tenantId",
    "proposalId",
    "status",
    "policyVersion",
    "requestedAt",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "$ref": "./common.json#/$defs/Id" },
    "specVersion": { "$ref": "./common.json#/$defs/SpecVersion" },
    "tenantId": { "$ref": "./common.json#/$defs/Id" },
    "proposalId": { "$ref": "./common.json#/$defs/Id" },
    "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired"] },
    "approverId": { "type": "string" },
    "comment": { "type": "string" },
    "policyVersion": { "type": "string" },
    "requestedAt": { "$ref": "./common.json#/$defs/DateTime" },
    "decidedAt": { "$ref": "./common.json#/$defs/DateTime" },
    "expiresAt": { "$ref": "./common.json#/$defs/DateTime" },
    "approverGroupId": { "type": "string" },
    "createdAt": { "$ref": "./common.json#/$defs/DateTime" },
    "updatedAt": { "$ref": "./common.json#/$defs/DateTime" }
  }
}
