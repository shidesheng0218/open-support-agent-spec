{
  "name": "@osas/compat-runner",
  "version": "0.2.1",
  "type": "module",
  "description": "Black-box HTTP conformance runner for the Open Support Agent Spec (OSAS): score any implementation over HTTP; gateOk is the registry gate.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shidesheng0218/open-support-agent-spec.git",
    "directory": "packages/compat-runner"
  },
  "keywords": [
    "osas",
    "conformance",
    "ai-agents",
    "customer-support",
    "governance",
    "black-box-testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "osas-compat": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "compat": "tsx src/cli.ts",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@osas/core": "workspace:*",
    "@osas/schema-validator": "workspace:*"
  },
  "devDependencies": {
    "@osas/api": "workspace:*",
    "fastify": "^5.2.0",
    "tsx": "^4.19.2"
  }
}
