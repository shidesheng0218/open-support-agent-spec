{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-support-agent.dev/schemas/core/case-note.json",
  "title": "CaseNote",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "specVersion", "tenantId", "caseId", "body", "createdAt"],
  "properties": {
    "id": { "$ref": "./common.json#/$defs/Id" },
    "specVersion": { "$ref": "./common.json#/$defs/SpecVersion" },
    "tenantId": { "$ref": "./common.json#/$defs/Id" },
    "caseId": { "$ref": "./common.json#/$defs/Id" },
    "body": { "type": "string" },
    "createdAt": { "$ref": "./common.json#/$defs/DateTime" }
  }
}
