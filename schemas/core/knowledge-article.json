{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-support-agent.dev/schemas/core/knowledge-article.json",
  "title": "KnowledgeArticle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "specVersion",
    "tenantId",
    "title",
    "body",
    "tags",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "$ref": "./common.json#/$defs/Id" },
    "specVersion": { "$ref": "./common.json#/$defs/SpecVersion" },
    "tenantId": { "$ref": "./common.json#/$defs/Id" },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "$ref": "./common.json#/$defs/DateTime" },
    "updatedAt": { "$ref": "./common.json#/$defs/DateTime" }
  }
}
